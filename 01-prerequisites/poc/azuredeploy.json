{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [ "dev", "test", "prod" ],
      "metadata": {
        "description": "Deploy-time knob. Different parameter files → same template, different environments."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the storage account."
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "pyxis",
      "minLength": 2,
      "maxLength": 8,
      "metadata": {
        "description": "Short alphanumeric prefix used in the storage account name."
      }
    },
    "storageReplication": {
      "type": "string",
      "defaultValue": "LRS",
      "allowedValues": [ "LRS", "GRS", "ZRS" ],
      "metadata": {
        "description": "Replication for Standard SKU. Keep LRS in sandboxes."
      }
    }
  },
  "variables": {
    "storageAccountName": "[take(toLower(concat('st', parameters('namePrefix'), parameters('environment'), uniqueString(resourceGroup().id))), 24)]",
    "storageSkuName": "[concat('Standard_', parameters('storageReplication'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[variables('storageSkuName')]"
      },
      "kind": "StorageV2",
      "tags": {
        "environment": "[parameters('environment')]",
        "workload": "az104-prereq",
        "managedBy": "arm"
      },
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "accessTier": "Hot"
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
    },
    "primaryBlobEndpoint": {
      "type": "string",
      "value": "[reference(variables('storageAccountName')).primaryEndpoints.blob]"
    }
  }
}
